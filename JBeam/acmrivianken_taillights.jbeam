{
"acmrivian_taillight_R": {
    "information":{
        "authors":"Kenemation",
        "name":"Right Taillight",
        "value":110,
    },
    "slotType" : "acmrivian_taillight_R",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["acmrivian_taillights_frame_R", ["acmrivian_taillight_R"]],

         {"deformGroup":"taillightglass_R_break", "deformMaterialBase":"acmrivian_glass", "deformMaterialDamaged":"acmrivian_glass_dmg"},
         ["acmrivian_taillightsglass_R", ["acmrivian_taillight_R"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>extglassbreaksound1", "deformVolume":0.3}],

         {"deformGroup":"taillightglass_R_break", "deformMaterialBase":"acmrivian_lights", "deformMaterialDamaged":"acmrivian_lights"},
         ["acmrivian_taillight_R", ["acmrivian_taillight_R"]],
         {"deformGroup":""},
    ],

    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
		{
            "lightInnerAngle":0,
            "lightOuterAngle":150,
			"flareScale":0.0,
            "lightRange":2,
			"lightBrightness":0.75,
            "lightColor":{"r":255, "g":0, "b":0, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":false,
			"cookieName":"art/special/BNG_light_cookie_headlight.dds"
            "flareName":"vehicleBrakeLightFlare",
        },
        //brake
		["brakelights" ,         "SPOTLIGHT"        , "tl3r", "tl2r", "tl1r", {"x":0, "y":0, "z":0} , {"x":0, "y":0, "z":0}    , {"x":1, "y":0, "z":0}, 0, 0, 0, 1, {"baseRotationGlobal":{"x":45, "y":0, "z":-15},"baseTranslationGlobal":{"x":-0.767,"y":2.699,"z":0.906},"deformGroup":"taillightglass_R_break"}],
		{
            "lightInnerAngle":0,
            "lightOuterAngle":150,
			"flareScale":0.0,
            "lightRange":3,
			"lightBrightness":0.15,
            "lightColor":{"r":255, "g":0, "b":0, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":false,
			"cookieName":"art/special/BNG_light_cookie_headlight.dds"
            "flareName":"vehicleBrakeLightFlare",
        },
        //running
		["ignition" ,         "SPOTLIGHT"        , "tl3r", "tl2r", "tl1r", {"x":0, "y":0, "z":0} , {"x":0, "y":0, "z":0}    , {"x":1, "y":0, "z":0}, 0, 0, 0, 1, {"baseRotationGlobal":{"x":50, "y":0, "z":-15},"baseTranslationGlobal":{"x":-0.804,"y":2.637,"z":0.944},"deformGroup":"taillightglass_R_break"}],
		{
            "lightInnerAngle":0,
            "lightOuterAngle":150,
			"flareScale":0.0,
            "lightRange":3,
			"lightBrightness":0.5,
            "lightColor":{"r":255, "g":0, "b":0, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":false,
			"cookieName":"art/special/BNG_light_cookie_headlight.dds"
            "flareName":"vehicleBrakeLightFlare",
        },
        //signal
		["signal_R" ,         "SPOTLIGHT"        , "tl3r", "tl2r", "tl1r", {"x":0, "y":0, "z":0} , {"x":0, "y":0, "z":0}    , {"x":1, "y":0, "z":0}, 0, 0, 0, 1, {"baseRotationGlobal":{"x":45, "y":0, "z":-25},"baseTranslationGlobal":{"x":-0.793,"y":2.655,"z":0.933},"deformGroup":"taillightglass_R_break"}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--taillight--
         //right
         {"selfCollision":true},
         {"collision":true},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"frictionCoef":0.5},
         {"nodeWeight":0.4},
         {"group":"acmrivian_taillight_R"},
         ["tl1r",-0.724,2.7391,0.9776],
         ["tl2r",-0.7201,2.7423,0.8897],
         ["tl3r",-0.8677,2.5124,0.8934],
         ["tl4r",-0.8566,2.4627,0.9732],
         {"selfCollision":false},
         {"nodeWeight":0.4},
         ["tl5r",-0.7763,2.5225,0.9379],
         {"group":""},
    ],

    "beams": [
          ["id1:", "id2:"],
          //--taillight--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":701000,"beamDamp":20},
          {"beamDeform":10000,"beamStrength":60000},
          //taillight main shape
          {"deformGroup":"taillightglass_R_break", "deformationTriggerRatio":0.05},
          {"deformLimitExpansion":1.2},
          ["tl1r", "tl2r"],
          ["tl2r", "tl3r"],
          ["tl3r", "tl4r"],
          ["tl4r", "tl1r"],
          ["tl1r", "tl3r"],
          ["tl5r", "tl2r"],
          ["tl5r", "tl3r"],
          ["tl5r", "tl4r"],
          ["tl5r", "tl1r"],

          //attach
          {"deformLimitExpansion":""},
          {"beamSpring":501000,"beamDamp":20},
          {"beamDeform":4000,"beamStrength":12000},
          {"breakGroup":"taillight_a_R"},
          ["tl1r", "q3r"],
          ["tl1r", "r4rr"],
          ["tl1r", "q2r"],
          ["tl1r", "q6r"],
          ["tl1r", "r3rr"],

          ["tl3r", "q3r"],
          ["tl3r", "r4rr"],
          ["tl3r", "q2r"],
          ["tl3r", "q6r"],
          ["tl3r", "r3rr"],

          ["tl4r", "q5r"],
          ["tl4r", "q6r"],
          ["tl4r", "q2r"],
          ["tl4r", "r3rr"],
          ["tl4r", "r4rr"],
          ["tl4r", "q1r"],
          {"breakGroup":""},
          {"deformGroup":""},

          //taillight support beams
          {"beamType":"|SUPPORT", "beamLongBound":4},
          {"beamSpring":401000,"beamDamp":20},
          {"beamDeform":5000,"beamStrength":330000},
          {"breakGroup":"taillight_R_supportBeams"},
          ["tl3r", "q3r"],
          ["tl2r", "q3r"],
          ["tl4r", "q2r"],
          ["tl4r", "q5r"],
          ["tl4r", "q7r"],
          ["tl4r", "q1r"],
          {"breakGroup":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.2},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //right taillight
            {"groundModel":"plastic"},
            {"group":"acmrivian_taillight_R"},
            {"dragCoef":5},
            ["tl1r", "tl2r", "tl3r"],
            ["tl1r", "tl3r", "tl4r"],
            {"triangleType":"NONCOLLIDABLE"},
            ["tl1r", "tl5r", "tl2r"],
            ["tl5r", "tl3r", "tl2r"],
            ["tl5r", "tl4r", "tl3r"],
            ["tl1r", "tl4r", "tl5r"],
            {"triangleType":"NORMALTYPE"},
            {"group":""},
    ],
},

"acmrivian_tunnel_hatch_L": {
    "information":{
        "authors":"Kenemation",
        "name":"Left Tunnel Hatch",
        "value":400,
    },
    "slotType" : "acmrivian_tunnel_hatch_L",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["acmrivian_tunnel_hatch_L", ["acmrivian_tunnel_hatch_L"]],
    ],

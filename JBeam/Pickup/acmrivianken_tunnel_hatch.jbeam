            ["cid1",    "cid2",     "autoCouplingStrength",    "autoCouplingRadius",   "autoCouplingLockRadius",   "autoCouplingSpeed", "couplingStartRadius",  "breakGroup"]
            ["th_cn_l",      "th10l",        40000,                     0.04,                   0.02,                      0.2,                 0.1,                   "tunnel_latch_L"]
        ]
        "attachSoundVolume":1,
        "detachSoundVolume":1,
        "soundNode:":["th10l"]
        "attachSoundEvent": "event:>Vehicle>Latches>Trunk>modern_05_close",
        "detachSoundEvent": "event:>Vehicle>Latches>Trunk>modern_05_open",
        "breakSoundEvent":""
        "openForceMagnitude": 25,
        "openForceDuration": 0.2,
        "closeForceMagnitude": 150,
        "closeForceDuration": 3,
    }
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["tunnelL", "", "th1l","th3l","th6l", "box", {"x":0.05, "y":0.01, "z":0.04}, {"x":-8, "y":0, "z":8}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":-0.025, "y":0.632, "z":-0.002}],
    ],
    "triggerEventLinks":[

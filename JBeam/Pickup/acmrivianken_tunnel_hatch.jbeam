          {"beamType":"|SUPPORT", "beamLongBound":15},
          {"beamSpring":1001000,"beamDamp":50},
          {"beamDeform":7500,"beamStrength":230000},
          {"breakGroup":"tunnel_latch_L_supportBeams"},

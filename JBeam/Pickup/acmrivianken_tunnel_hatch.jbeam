          ["th8l","th9l"],
          ["th7l","th9l"],
          ["th4l","th9l"],
          ["th5l","th9l"],
          ["th6l","th9l"],
          ["th1l","th9l"],
          ["th2l","th9l"],
          ["th3l","th9l"],
		  ["th9l","th10l"],
		  
		  //latch node

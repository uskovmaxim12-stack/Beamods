        ["tunnelL", "action0", "tunnelL"],
    ],
    "events":[
        ["id", "title", "desc"],
        ["tunnelL", "", "", {"onUp":"controller.getControllerSafe('tunnelCouplerL').toggleGroup()"}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
         //--TAILGATE--
         {"collision":true},
         {"selfCollision":false},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"acmrivian_tunnel_hatch_L"},

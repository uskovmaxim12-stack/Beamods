          {"beamType":"|BOUNDED","beamLongBound":2,"beamShortBound":1},
          {"beamDeform":150000,"beamStrength":15000},
          {"beamSpring":0,"beamDamp":50},
          {"beamLimitSpring":500,"beamLimitDamp":75},
          ["th5l", "th_cn_l", {"breakGroup":"tunnel_latch_L"}],

		 {"collision":false},
         {"selfCollision":false},
         {"nodeWeight":1},
         ["th10l", 0.6936, 1.3535, 0.8223],
         
         ["th_cn_l", 0.6936, 1.3535, 0.8223],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":1501000,"beamDamp":25},

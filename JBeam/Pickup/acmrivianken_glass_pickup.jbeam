{
"acmrivian_doorglass_RR_pickup": {
    "information":{
        "authors":"Kenemation",
        "name":"Rear Right Door Glass",
        "value":50,
    },
    "slotType" : "acmrivian_doorglass_RR_pickup",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         {"deformGroup":"doorglass_RR_break", "deformMaterialBase":"acmrivian_glass_pickup", "deformMaterialDamaged":"acmrivian_glass_pickup_dmg"},
         ["acmrivian_doorglass_RR_pickup", ["acmrivian_door_RR"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound7", "deformVolume":0.7}],
         {"deformGroup":""},
		 
		 {"deformGroup":"doorglass_RR_break", "deformMaterialBase":"acmrivian_glass_pickup_int", "deformMaterialDamaged":"acmrivian_glass_pickup_int_dmg"},
         ["acmrivian_doorglass_RR_pickup_int", ["acmrivian_door_RR"]],
         {"deformGroup":""},
    ],
    "sounds": {
        "$+cabinFilterCoef": 0.04
    }
},

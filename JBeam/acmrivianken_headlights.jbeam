        ["ignition" ,         "SPOTLIGHT"        , "hl2r", "hl1r", "hl3r", {"x":0, "y":0, "z":0} , {"x":0, "y":0, "z":0}    , {"x":1, "y":0, "z":0}, 0, 0, 0, 1, {"baseRotationGlobal":{"x":-20, "y":0, "z":-160},"baseTranslationGlobal":{"x":-0.584, "y":-2.141, "z":0.755},"deformGroup":"headlightglass_R_break", "lightScaling":{}}],

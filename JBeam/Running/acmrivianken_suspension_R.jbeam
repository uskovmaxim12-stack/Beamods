          ["rx1r", "rx2r"],
          ["rx1l", "rx1r"],
          ["rx2l", "rx2r"],

          ["rx3l", "rx3r"],
          ["rx1r", "rx3r"],
          ["rx2r", "rx3r"],
          ["rx1l", "rx3l"],
          ["rx2l", "rx3l"],


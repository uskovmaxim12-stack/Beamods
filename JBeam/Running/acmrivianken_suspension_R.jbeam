{
"acmrivian_suspension_R": {
    "information":{
        "authors":"Kenemation",
        "name":"Independent Rear Suspension",
        "value":6400,
    },
    "slotType" : "acmrivian_suspension_R",
    "slots": [
        ["type", "default", "description"],
        ["acmrivian_brake_R","acmrivian_brake_R_race", "Rear Brakes", {"nodeOffset":{"x":0.065, "y":0, "z":0}}],
        //To change the base track width, edit the trackoffset_R offset in the expression.
        ["wheel_R_5","acmrivian_wheel_R_chrome","Rear Wheels", {"nodeOffset":{"x":"$=$trackoffset_R+0.35", "y":1.725, "z":0.32}}],
		//387
        ["acmrivian_wheeldata_R","acmrivian_wheeldata_R", "Rear Spindles", {"coreSlot":true}],
        ["acmrivian_coilover_R","acmrivian_strut_R", "Rear Coilovers"],
        ["acmrivian_swaybar_R","acmrivian_swaybar_R", "Rear Sway Bar"],
        ["acmrivian_differential_R","acmrivian_differential_R_race", "Rear Differential"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //rear running gear
         ["acmrivian_subframe_R_race", ["acmrivian_subframe_R"]],
         ["acmrivian_lowerarm_R_race", ["acmrivian_lowerarm_R"]],
         ["acmrivian_toelink_R_race", ["acmrivian_toelink_R","acmrivian_subframe_R"]],
         ["acmrivian_hub_race_R", ["acmrivian_hub_R"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_RR_rally", "range", "", "Wheel Alignment", 0.93, 0.9, 1.0, "Camber Adjust", "Adjusts the wheel camber angles", {"subCategory":"Rear"}],
        ["$toe_RR_rally", "range", "", "Wheel Alignment", 0.99, 0.98, 1.02, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Rear"}],
        ["$trackoffset_R", "range", "+m", "Wheels", 0.0,-0.02, 0.05, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.001,"subCategory":"Rear"}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"collision":true},
         {"selfCollision":true},
         //--REAR SUBFRAME--
         //lower arm mounts
         {"nodeWeight":6.0}
         {"group":["acmrivian_lowerarm_R", "acmrivian_subframe_R"]},
		 //537
         ["rx1r",-0.345,1.5373,0.202],
         ["rx1l", 0.345,1.5373,0.202],
         ["rx2r",-0.345,1.9173,0.178, {"tag":"rideheight_RR"}],
         ["rx2l", 0.345,1.9173,0.178, {"tag":"rideheight_RL"}],
         ["rx2",  0.0,  1.4873, 0.45, {"nodeWeight":3.0,"selfCollision":false,"group":"acmrivian_halfshaft_R"}],
         //toe link mounts
         {"nodeWeight":5.0}
         {"group":["acmrivian_lowerarm_R", "acmrivian_subframe_R","acmrivian_halfshaft_R"]},
         ["rx3r",-0.31,1.8573,0.298],
         ["rx3l", 0.31,1.8573,0.298],
         //subframe shape
         {"nodeWeight":2.5}
         {"group":"acmrivian_subframe_R"},
         {"selfCollision":false},
         ["rx4r",-0.47,1.5073,0.375],
         ["rx4l", 0.47,1.5073,0.375],
         ["rx5r",-0.47,1.8473,0.455],
         ["rx5l", 0.47,1.8473,0.455],
         {"selfCollision":true},

         //--REAR INDEPENDENT SUSPENSION--
         {"collision":true},
         {"selfCollision":true},
         //rear hubs
         {"nodeWeight":7.5},
         {"group":["acmrivian_lowerarm_R", "acmrivian_coilover_R", "acmrivian_hub_R"]}
         ["rh1r",-0.81,1.7053,0.19],
         ["rh1l", 0.81,1.7053,0.19],
         {"group":["acmrivian_hub_R","acmrivian_halfshaft_R"]}
         {"nodeWeight":4.5},
         ["rh2r",-0.80,1.5873,0.34],
         ["rh2l", 0.80,1.5873,0.34],
         {"group":["acmrivian_toelink_R","acmrivian_hub_R","acmrivian_halfshaft_R"]}
         ["rh3r",-0.80,1.8573,0.322],
         ["rh3l", 0.80,1.8573,0.322],
         {"group":["acmrivian_hub_R", "acmrivian_coilover_R"]},
         {"selfCollision":false},
         ["rh4r",-0.7022,1.7053,0.555],
         ["rh4l", 0.7022,1.7053,0.555],
         //rear shock top
         {"nodeWeight":3.5},
         ["rs1r",-0.63,1.7053,0.8, {"group":["acmrivian_body","acmrivian_coilover_R"]}],
         ["rs1l", 0.63,1.7053,0.8, {"group":["acmrivian_body","acmrivian_coilover_R"]}],


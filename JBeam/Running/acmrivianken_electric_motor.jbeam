          {"breakGroup":"enginemount_a"},
          {"dampCutoffHz":500},
          {"boundZone":0.01},
          ["fem5r", "f12rr"],
          ["fem5r", "f10rr"],
          ["fem5r", "f12ll", {"boundZone":0.003}],
          ["fem5r", "f10ll", {"boundZone":0.003}],
          ["fem5r", "f1r"],
          ["fem5r", "f5r"],

          {"breakGroup":"enginemount_b"},
          ["fem5l", "f12ll"],
          ["fem5l", "f10ll"],
          ["fem5l", "f12rr", {"boundZone":0.003}],
          ["fem5l", "f10rr", {"boundZone":0.003}],
          ["fem5l", "f1l"],
          ["fem5l", "f5l"],

          //torque mount
          {"beamType":"|BOUNDED", "longBoundRange":0.01, "shortBoundRange":0.01},
          {"beamSpring":851000,"beamDamp":2000},
          {"beamDeform":40000,"beamStrength":90000},
          {"breakGroup":"enginemount_c"},
          {"boundZone":0.01},
          ["fem6", "fx6l"],
          ["fem6", "fx6r"],
          ["fem6", "fx2r"],
          ["fem6", "fx2l"],
          ["fem6", "fx1l"],
          ["fem6", "fx1r"],
          ["fem1l", "fx3l"],
          ["fem1r", "fx3r"],
          {"boundZone":""},
          {"breakGroup":""},
          {"beamType":"|NORMAL", "longBoundRange":"", "shortBoundRange":""},

          //damper
          {"beamDeform":15000,"beamStrength":60000},
          {"beamSpring":51000,"beamDamp":8000},
          ["fem4l", "fx3l"],
          ["fem4r", "fx3r"],
          ["fem4r", "fx1r"],
          ["fem4l", "fx1l"],
          {"dampCutoffHz":""},

          //prevent unrealistic motor ejection
          {"beamSpring":21000,"beamDamp":300},
          {"beamDeform":10000,"beamStrength":50000},
          ["fem4l", "f12rr"],
          ["fem3l", "f12rr"],
          ["fem3r", "f12ll"],
          ["fem4r", "f12ll"],
          ["fem3l", "f5l"],
          ["fem3r", "f5r"],
          {"beamSpring":7000,"beamDamp":300},
          ["fem4l", "fx3r"],
          ["fem4l", "fx1r"],
          ["fem4r", "fx3l"],
          ["fem4r", "fx1l"],

          //motor limiters
          {"beamType":"|SUPPORT", "beamLongBound":5.0},
          {"beamSpring":1001000,"beamDamp":150,"beamDeform":50000,"beamStrength":"FLT_MAX"},
          //front end collide
          {"beamPrecompression":0.3},
          ["fem2r", "f11rr"],
          ["fem4r", "f13rr"],
          ["fem2l", "f11ll"],
          ["fem4l", "f13ll"],
          ["fem2r", "f18r"],
          ["fem2l", "f18l"],

          //firewall collide
          {"beamDeform":40000},
          {"beamPrecompression":0.8},
          ["fem1l", "f1l"],
          ["fem3l", "f5l"],
          ["fem1r", "f1r"],
          ["fem3r", "f5r"],
          ["fem1r", "f1l"],
          ["fem1l", "f1r"],
          ["fem3r", "f5l"],
          ["fem3l", "f5r"],
          ["fem3r", "f6r"],
          ["fem3l", "f6l"],

          //side collide
          {"beamSpring":3001000,"beamDeform":50000},
          {"beamPrecompression":0.95},
          ["fem3r", "f10ll"],
          ["fem4r", "f10ll"],
          ["fem3l", "f10rr"],
          ["fem4l", "f10rr"],
          ["fem1l", "f10rr"],
          ["fem2l", "f10rr"],
          ["fem1r", "f10ll"],
          ["fem2r", "f10ll"],

          //subframe collide
          {"beamPrecompression":0.95},
          ["fem4r", "fx2r"],
          ["fem4r", "fx1r"],
          ["fem3r", "fx1r"],
          ["fem4l", "fx2l"],
          ["fem4l", "fx1l"],
          ["fem3l", "fx1l"],

          //extreme crash situations
          {"beamType":"|SUPPORT", "beamLongBound":15.0},
          {"beamSpring":3001000,"beamDeform":20000},
          {"beamPrecompression":0.8},
          ["fem1r", "f3rr"],
          ["fem1l", "f3ll"],
          ["fem3l", "f3ll"],
          ["fem3r", "f3rr"],
          ["fem3r", "f3l"],
          ["fem3l", "f3r"],
          ["fem1r", "f3l"],
          ["fem1l", "f3r"],

          //motor break
          {"beamLongBound":0.9},
          {"beamSpring":401000,"beamDamp":150,"beamDeform":110000},
          {"beamPrecompression":0.7},
          ["fem4l", "f13rr", {"name":"front_motor","beamStrength":35000,"disableMeshBreaking":true,"disableTriangleBreaking":true}],
          ["fem4r", "f13ll", {"name":"front_motor","beamStrength":35000,"disableMeshBreaking":true,"disableTriangleBreaking":true}],

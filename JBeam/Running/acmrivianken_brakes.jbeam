        ["mesh", "[group]:", "nonFlexMaterials"],
        ["brake_hub_5l",                 ["wheel_RR",    "wheelhub_RR"], [],    {"pos":{"x":-0.77, "y":1.725, "z":0.32}, "scale":{"x":0.9,  "y":1.15,  "z":1.15},    "rot":{"x":0,   "y":0,   "z":0}}],
        ["brake_hub_5l",                 ["wheel_RL",    "wheelhub_RL"], [],    {"pos":{"x": 0.77, "y":1.725, "z":0.32}, "scale":{"x":0.9,  "y":1.15,  "z":1.15},    "rot":{"x":0,   "y":0,   "z":180}}],
        ["brake_disc_drilled",           ["wheel_RR",    "wheelhub_RR"], [],    {"pos":{"x":-0.77, "y":1.725, "z":0.32}, "scale":{"x":0.93, "y":1.15, "z":1.15},     "rot":{"x":0,   "y":0,   "z":0}}],
        ["brake_disc_drilled",           ["wheel_RL",    "wheelhub_RL"], [],    {"pos":{"x": 0.77, "y":1.725, "z":0.32}, "scale":{"x":0.93, "y":1.15, "z":1.15},     "rot":{"x":180, "y":0,   "z":0}}],
        ["acmrivian_brake_caliper_R",    ["acmrivian_hub_R","wheelhub_RR"], [], {"pos":{"x":-0.77, "y":1.725, "z":0.32}, "scale":{"x":1.0,  "y":1.0, "z":1.0},       "rot":{"x":0,   "y":180,   "z":0}}],
        ["acmrivian_brake_caliper_R",    ["acmrivian_hub_R","wheelhub_RL"], [], {"pos":{"x": 0.77, "y":1.725, "z":0.32}, "scale":{"x":1.0,  "y":1.0, "z":1.0},       "rot":{"x":0,   "y":0, "z":0}}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
        {"brakeTorque":"$=$brakestrength*2500"},
        {"brakeInputSplit":0.5},
        {"brakeSplitCoef":0.5},
        {"parkingTorque":3000},
        {"brakeSpring":100},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.35},
        {"brakeMass":6},
        {"brakeType":"vented-disc"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":20},
        //abs
        {"absSlipRatioTarget":0.25},
        //brake sounds
        {"squealCoefNatural": 0.0, "squealCoefLowSpeed": 0.0}
    ],
},
}
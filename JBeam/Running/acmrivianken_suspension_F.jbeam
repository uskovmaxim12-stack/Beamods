    "slotType" : "acmrivian_steering",
    "slots": [
        ["type", "default", "description"],
        ["acmrivian_power_steering","", "Power Steering"],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["acmrivian_tierod_race_R", ["acmrivian_tierod_F"]],
        ["acmrivian_tierod_race_L", ["acmrivian_tierod_F"]],
        ["acmrivian_steeringboot_race_R", ["acmrivian_steeringboot_FR", "acmrivian_steeringbox"]],
        ["acmrivian_steeringboot_race_L", ["acmrivian_steeringboot_FL", "acmrivian_steeringbox"]],
    ],
    "rails":{
        "steeringrack":{"links:":["fh6r", "fh6l"], "broken:":[], "looped":false, "capped":true},
        "tierod_R":{"links:":["fh6r", "fh3r"], "broken:":[], "looped":false, "capped":true},
        "tierod_L":{"links:":["fh6l", "fh3l"], "broken:":[], "looped":false, "capped":true},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["fx5r", "steeringrack", true, true, 0.0, 14001000, "FLT_MAX", "FLT_MAX"],
        ["fx5l", "steeringrack", true, true, 0.0, 14001000, "FLT_MAX", "FLT_MAX"],
        ["td1r", "tierod_R", true, true, 0.0, 501000, "FLT_MAX", "FLT_MAX"],
        ["td1l", "tierod_L", true, true, 0.0, 501000, "FLT_MAX", "FLT_MAX"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$toe_FR_rally", "range", "", "Wheel Alignment", 0.987, 0.98, 1.02, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Front"}],
        ["$steer_center_F", "range", "", "Wheel Alignment", 0, -0.002, 0.002, "Toe Left/Right Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Front"}]
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--steering rod--
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"acmrivian_tierod_F"},
         {"nodeWeight":5.25},
         ["fh6r", -0.32, -1.184, 0.28],
         ["fh6l",  0.32, -1.184, 0.28],

         //boot
         {"nodeWeight":0.05},
         {"collision":true},
         ["td1r",-0.426, -1.188, 0.287, {"group":"acmrivian_steeringboot_FR"}],
         ["td1l", 0.426, -1.188, 0.287, {"group":"acmrivian_steeringboot_FL"}],
         {"group":""},
    ],
    "beams": [
          ["id1:","id2:"],
          {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":12001000,"beamDamp":500,"beamDeform":95000,"beamStrength":325000},
          ["fh6r","fh6l", {"dampCutoffHz":1000}],
          {"beamSpring":18001000},
          ["fh3r","fh6r", {"beamPrecompression":"$=$toe_FR_rally-$steer_center_F","beamPrecompressionTime":0.5, "dampCutoffHz":1000}],
          ["fh3l","fh6l", {"beamPrecompression":"$=$toe_FR_rally+$steer_center_F","beamPrecompressionTime":0.5, "dampCutoffHz":1000}],
          //steering damper

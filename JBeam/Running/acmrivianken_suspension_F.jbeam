          {"beamSpring":0,"beamDeform":15120,"beamStrength":37800},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          {"beamDamp":80},
          ["fh3r","fx1r", {"beamDampVelocitySplit":0.15,"beamDampFast":500,"dampCutoffHz":500}],
          ["fh3l","fx1l", {"beamDampVelocitySplit":0.15,"beamDampFast":500,"dampCutoffHz":500}],
          ["fh5r","fx2r", {"beamDampVelocitySplit":0.15,"beamDampFast":500,"dampCutoffHz":500}],
          ["fh5l","fx2l", {"beamDampVelocitySplit":0.15,"beamDampFast":500,"dampCutoffHz":500}],
          {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},

          //boot
          {"beamSpring":101000,"beamDamp":20,"beamDeform":15000,"beamStrength":127500},
          ["fh6r", "td1r"],
          ["fh6l", "td1l"],
    ],

    "hydros": [
        ["id1:","id2:"],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":11001000,"beamDamp":50,"beamDeform":"FLT_MAX","beamStrength":83250},
        ["fh6r","fx5l", {"factor":-0.165,"steeringWheelLock":450, "inRate":5,"outRate":5}],
        ["fh6l","fx5r", {"factor":0.165,"steeringWheelLock":450, "inRate":5,"outRate":5}],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "input": {
        "FFBcoef":"$=$ffbstrength*7",
    },
},

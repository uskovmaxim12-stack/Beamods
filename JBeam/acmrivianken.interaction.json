// this file holds all the actions that only this specific vehicle can perform
// ===========================================================================
// the non self-descriptive fields are:
// "onChange":   code to run when the controller position changes     (applies to: buttons, keys, pov hat, axes)
// "onDown":     code to run when the controller becomes pressed down (applies to: buttons, keys, pov hat)
// "onUp":       code to run when the controller is lifted up         (applies to: buttons, keys, pov hat)
// "onRelative": code to run when the controller position changes     (applies to: mouse axis when holding right mouse button)
// "ctx" (defaults to 'vlua'): where the code above ^ must be run. it can be:
//    - vlua for vehicle lua async
//    - elua for engine  lua async
//    - tlua for engine  lua  sync
//    - ui for javascript    async
//    - ts for torquescript   sync
// "isBasic" (defaults to true): whether the binding must show always (true), or only when 'advanced bindings' checkbox is marked (false)
// "isCentered" (defaults to false): whether the axis values will be reported from -1 to +1 (true) or from 0 to +1 (false)
// "order":      helps set the display order in the Controls menu
{
  "fileversion": 2,
  "actions": {
	"text":   {"order":  1, "onDown":"", "title": "Mod made by Kenemation Mods"},
    "dashboard_night_mode": {"order":2,"onDown":"electrics.values.dashboard_night_mode=1-(electrics.values.dashboard_night_mode or 0)","title":"Dashboard Mode","desc":"Switches Color mode on the dashboard"},
    "autohold_button": {"order":3,"onDown":"electrics.values.autoholdTrigger=1-(electrics.values.autoholdTrigger or 0)","title":"Enable/Disable Auto Hold","desc":"Enable or Disable Auto Hold"},
	
	"min_rideHeight":{"order":  4,  "onDown":"electrics.values.min_rideHeight = 1", "onUp":"electrics.values.min_rideHeight = 0", "title": "Min height", "desc": "Sets the minimum ride height for the vehicle" },
	"default_rideHeight":{"order":  5,  "onDown":"electrics.values.default_rideHeight = 1", "onUp":"electrics.values.default_rideHeight = 0", "title": "Default height", "desc": "Sets the default ride height for the vehicle" },
	"max_rideHeight":{"order":  6,  "onDown":"electrics.values.max_rideHeight = 1", "onUp":"electrics.values.max_rideHeight = 0", "title": "Max height", "desc": "Sets the maximum ride height for the vehicle" },
	
	"tlamp_main": {"order":7,"onDown":"electrics.values.tlamp_main=1-(electrics.values.tlamp_main or 0)","title":"Enable/Disable Interior Lights","desc":"Enable or Disable Interior Lights"},
    "hazard_trigger": {"order":8,"onDown":"electrics.toggle_warn_signal()","title":"Enable/Disable Hazard Lights","desc":"Enable or Disable Hazard Lights"},
	
	"rideHeight_up":{"order":9,"onDown":"controller.getController('airSuspension_acmrivian').suspensionPresetUp()","title":"Suspension Preset Up","desc":"Increase suspension preset"},
	"rideHeight_down":{"order":10,"onDown":"controller.getController('airSuspension_acmrivian').suspensionPresetDown()","title":"Suspension Preset Down","desc":"Decrease suspension preset"}
  }
}




          //--DASHBOARD--
          {"beamSpring":3001000,"beamDamp":100},
          {"beamDeform":12000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":""},
          {"deformGroup":"display_break","deformationTriggerRatio":0.05},

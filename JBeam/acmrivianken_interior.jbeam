{
"acmrivian_dash": {
    "information":{
        "authors":"Kenemation",
        "name":"Interior",
        "value":400,
    },
    "slotType" : "acmrivian_dash",
    "slots":[
        ["type", "default", "description"],
        ["acmrivian_gauges","acmrivian_gauges", "Gauge", {"coreSlot":true}],
        ["soundscape_horn", "soundscape_horn_122", "Horn"],
    ],
    "camerasInternal":[
        ["type", "x", "y", "z", "fov", "id1:", "id2:", "id3:", "id4:", "id5:", "id6:"],
        {"nodeWeight":2.9},
        {"beamSpring":650,"beamDamp":120},
        {"selfCollision":true},
        {"collision":true},
        //dash cam
        ["dash", 0.385, 0.32, 1.31, 65, "f1ll","f2r","f3ll","f4ll","f4r",[], {"beamDeform":5001000,"beamStrength":"FLT_MAX"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["acmrivian_dash", ["acmrivian_dash"]],
         ["acmrivian_console", ["acmrivian_floor", "acmrivian_console"]],
         ["acmrivian_intermirror", ["acmrivian_body"]],
		 
         ["acmrivian_interior_roof", ["acmrivian_body"]],
         ["acmrivian_interior_floor", ["acmrivian_body"]],
    ],
    "mirrors": [
        ["mesh", "idRef:", "id1:", "id2:"],
        ["acmrivian_intermirror","rf1","rf1r","rf2",{"refBaseTranslation":{"x":0.060,"y":0.015,"z":-0.140},"baseRotationGlobal":{"x":4.9,"y":0.0,"z":14.9}}],
    ],
    "props": [
        ["func",       "mesh",               "idRef:", "idX:", "idY:",  "baseRotation",            "rotation",               "translation",          "min", "max", "offset", "multiplier"],
        //steering column controls
        ["turnsignal", "acmrivian_signalstalk", "dsh2l",  "dsh2r","dshl", {"x":0, "y":0, "z":0} , {"x":0, "y":-12.5, "z":0}, {"x":0, "y":0, "z":0}, -1, 1, 0, 1, {"baseRotationGlobal":{"x":0, "y":0, "z":0}}],
        ["shifterPulse", "acmrivian_gearstalk",   "dsh2l",  "dsh2r","dshl", {"x":0, "y":0, "z":0} , {"x":0, "y":-12.5, "z":0}, {"x":0, "y":0, "z":0}, -1, 1, 0, 1, {"baseRotationGlobal":{"x":0, "y":0, "z":0}}],
		
        //pedals
        ["throttle",   "acmrivian_pedal_gas",   "f1l","f1r","f6l",         {"x":0, "y":0, "z":180},   {"x":-25, "y":0, "z":0},  {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
        ["brake",   "acmrivian_pedal_brake",   "f1l","f1r","f6l",         {"x":0, "y":0, "z":180},   {"x":-25, "y":0, "z":0},  {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
    ],
    "sounds": {
        "$+cabinFilterCoef": 0.12
    },
    "soundscape": [
        ["name", "src"],
        //indicator6,
        {"node:":"int_strw"},
        ["indicatorStart", "event:>Vehicle>Interior>Indicator>FIPA_On"],
        ["indicatorStop", "event:>Vehicle>Interior>Indicator>FIPA_Off"],
        ["indLoop1", "event:>Vehicle>Interior>Indicator>PEU_Click"],
        ["indLoop2", "event:>Vehicle>Interior>Indicator>PEU_Clack"],
        //lights11
        ["LightOn", "event:>Vehicle>Interior>Light>PETE2_On"],
        ["LightOff", "event:>Vehicle>Interior>Light>PETE2_Off"],
        //affects horn location because horn soundscape is loaded after
        {"node:":"f15"},
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"collision":true},
         {"selfCollision":false},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         //dashboard
         {"group":"acmrivian_dash"},

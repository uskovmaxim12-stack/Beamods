{
"acmrivian_glass_F": {
    "information":{
        "authors":"Kenemation",
        "name":"Windshield",
        "value":330,
    },
    "slotType" : "acmrivian_glass_F",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         {"deformGroup":"windshield_break", "deformMaterialBase":"acmrivian_glass", "deformMaterialDamaged":"acmrivian_glass_dmg"},
         ["acmrivian_windshield", ["acmrivian_windshield"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>impact_glass_windscreen_01", "deformVolume":0.7}],
         {"deformGroup":""},
		 
		 {"deformGroup":"windshield_break", "deformMaterialBase":"acmrivian_glass_int", "deformMaterialDamaged":"acmrivian_glass_int_dmg"},
         ["acmrivian_windshield_int", ["acmrivian_windshield"]],
         {"deformGroup":""},
		 
		 {"deformGroup":"windshield_break", "deformMaterialBase":"glass_invisible", "deformMaterialDamaged":"glass_mirror"},
         ["acmrivian_windshield_dmg", ["acmrivian_windshield"]],
         {"deformGroup":""},
    ],
    "sounds": {
        "$+cabinFilterCoef": 0.12
    }
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":true},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_GLASS"},
         {"nodeWeight":2.0},
         {"group":["acmrivian_windshield","gps"]},
         ["wi1", -0.0000, -0.6487, 1.2752],
         {"group":""},
         {"nodeMaterial":"|NM_METAL"},

         //--NODE WEIGHT ADD--
         //windshield
         {"group":"acmrivian_body"},

         //a pillars
         {"nodeWeight":2.5},
         ["p2r",-0.7954,-0.4578,1.2702, {"group":["acmrivian_body","gps","acmrivian_windshield"]}],
         ["p2l",0.7954,-0.4578,1.2702, {"group":["acmrivian_body","gps","acmrivian_windshield"]}],

         //roof
         {"nodeWeight":2.9},
         ["rf1r",-0.6552,-0.1496,1.5329, {"group":["acmrivian_body","gps","acmrivian_windshield"]}],
         ["rf1",0.0,-0.2261,1.5454, {"nodeWeight":2.4,"group":["acmrivian_body","gps","acmrivian_windshield"]}],
         ["rf1l",0.6552,-0.1496,1.5329, {"group":["acmrivian_body","gps","acmrivian_windshield"]}],

         //firewall
         {"nodeWeight":6.1},
         {"group":["acmrivian_engine_bay","acmrivian_windshield","gps","acmrivian_body","acmrivian_dash"]},
         ["f6rr",-0.7834,-0.883,1.0326],
         ["f6r",-0.3464,-0.9698,1.0515, {"group":["acmrivian_engine_bay","acmrivian_windshield","gps","acmrivian_body","acmrivian_strutbar","acmrivian_dash"]}],
         ["f6l",0.3464,-0.9698,1.0515, {"group":["acmrivian_engine_bay","acmrivian_windshield","gps","acmrivian_body","acmrivian_strutbar","acmrivian_dash"]}],
         ["f6ll",0.7834,-0.883,1.0326],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamPrecompression":1, "beamLongBound":1.0, "beamShortBound":1.0},
          //windshield
          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"beamSpring":1001000,"beamDamp":50},
          {"beamDeform":4100,"beamStrength":"FLT_MAX"},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformGroup":"windshield_break","deformationTriggerRatio":0.03},
          ["rf1","wi1"],
          ["rf1r","wi1"],
          ["rf1l","wi1"],
          ["wi1","f6r"],
          ["wi1","f6l"],
          ["wi1","p1r"],
          ["wi1","p1l"],
          ["wi1","f6rr"],
          ["wi1","f6ll"],

          ["wi1","p2rr"],
          ["wi1","p2ll"],
          {"beamDeform":5550,"beamStrength":12750},
          ["rf1","f6r"],
          ["rf1","f6l"],

          ["p1r","p1l"],

          ["rf1r","f6r"],
          ["rf1l","f6l"],

          {"breakGroup":""},
          {"disableMeshBreaking":false,"disableTriangleBreaking":false},
          {"deformGroup":""},
          {"deformLimitExpansion":1.2},
    ],
},
